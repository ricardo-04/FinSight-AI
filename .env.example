# FinSight AI - Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# LLM Provider
# Options: nim | ollama | openai
# ---------------------------------------------------------------------------
LLM_PROVIDER=nim

# NVIDIA NIM (https://build.nvidia.com - free tier)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=meta/llama-3.1-8b-instruct
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIMENSIONS=1024

# Ollama (local) - uncomment if using Ollama instead of NIM
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# OpenAI - uncomment if using OpenAI instead
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finsight

# ---------------------------------------------------------------------------
# RAG Pipeline
# ---------------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RAG_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.75
MAX_PROMPT_INPUT_LENGTH=8000
EMBEDDING_INPUT_TYPE=passage
